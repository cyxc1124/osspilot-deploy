# 复制为 compose/.env 后按需修改

IMAGE_TAG=develop

JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PROJECTION_SECRET=change-me-projection

TENANT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TENANT_API_PUBLIC_URL=http://localhost:8000
TENANT_WEB_API_URL=http://localhost:8000
OPS_WEB_API_URL=http://localhost:8001

# 外接 RGW / Ceph / ONLYOFFICE（可不填，运营端设置里再配）
S3_ENDPOINT=
RGW_ACCESS_KEY=
RGW_SECRET_KEY=
S3_REGION=us-east-1
CEPH_MGMT_API_URL=
OFFICE_URL=
OFFICE_JWT_SECRET=
LIFECYCLE_INTERVAL=1h
